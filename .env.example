# ---------------------------------------------------------------------------
# Copy this file to .env next to docker-compose.yml and edit the values.
#   cp .env.example .env
# docker-compose.yml reads this file automatically. Never commit .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=onemapan
POSTGRES_PASSWORD=change_me_to_a_strong_database_password
POSTGRES_DB=onemapan

# --- Backend ----------------------------------------------------------------
# Strong secret, minimum 32 characters. Generate one with:
#   openssl rand -hex 48
JWT_SECRET=change_me_to_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Public URL of the BACKEND without a trailing slash. Poster/image URLs are
# built from this value, so it must be reachable by the browser.
# Use the real domain as soon as DNS is set up.
SERVER_BASE_URL=http://your-server-ip

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://your-server-ip

# --- Frontend ---------------------------------------------------------------
# Inlined into the Next.js bundle at build time, must include the /api path
# (the same value as SERVER_BASE_URL + /api).
NEXT_PUBLIC_API_URL=http://your-server-ip/api

# --- Optional ---------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE=5242880
