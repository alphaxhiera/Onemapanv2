NODE_ENV=development
PORT=2025
DATABASE_URL="postgresql://postgres:password@localhost:5432/one-mapan"

# Required. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d

SERVER_BASE_URL=http://localhost:2025

# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000

# Bind address. Use 127.0.0.1 when a local reverse proxy (Nginx) is in front
# of the API; leave as 0.0.0.0 inside containers or when published directly.
# HOST=127.0.0.1

# Max upload size in bytes (default 5 MB).
UPLOAD_MAX_FILE_SIZE=5242880
